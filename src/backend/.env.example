# === 模型配置 ===
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# === 服务监听 ===
HOST=0.0.0.0
PORT=8000
RELOAD=1

# === 日志 / 存档 ===
LOG_DIR=logs
SAVES_DIR=src/backend/saves

# === 内容分级（阶段四生效）===
GORE_ENABLED=0
ADULT_CONTENT_ENABLED=0
POLISH_LENGTH=medium

# === LLM 调用限制 ===
MAX_LLM_CALLS_PER_TICK=20
